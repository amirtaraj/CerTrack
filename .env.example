# Copy to server/.env (local dev) or set these in docker-compose / your host.
MONGODB_URI=mongodb://127.0.0.1:27017/certtracker
PORT=4000

# REQUIRED in production: 32+ random characters.  Generate: openssl rand -hex 32
JWT_SECRET=

# First admin. Created on startup if no admin exists yet; they must change this password at first sign-in.
ADMIN_EMP_ID=1000
ADMIN_NAME=Certification Admin
ADMIN_PASSWORD=ChangeMe-Admin1

# Starting password for people created by import / "Add a person" / password reset.
# They are forced to choose their own at first sign-in.
DEFAULT_PASSWORD=Welcome@123

# Certifications count as "expiring soon" within this many days.
EXPIRING_DAYS=90

# Set to false only if you serve the app over plain http (e.g. an internal server without TLS).
# COOKIE_SECURE=false
